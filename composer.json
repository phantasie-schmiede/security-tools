{
	"authors": [
		{
			"email": "dn@phantasie-schmiede.de",
			"name": "Daniel Ablass",
			"role": "Developer"
		}
	],
	"autoload": {
		"psr-4": {
			"PSBits\\Security\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PSBits\\Security\\Tests\\": "Tests/"
		}
	},
	"config": {
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor",
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		}
	},
	"description": "security enhancements for TYPO3 extensions",
	"extra": {
		"typo3/cms": {
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "security",
			"web-dir": ".Build/public"
		}
	},
	"keywords": [
		"configuration",
		"development",
		"extension",
		"typo3"
	],
	"license": "GPL-3.0-or-later",
	"name": "psbits/security",
	"repositories": [
		{
			"type": "path",
			"url": "./Tests/Functional/Fixtures/Extensions/*"
		}
	],
	"require": {
		"php": "^8.3",
		"psb/psb-foundation": "^2.0",
		"typo3/cms-core": "^13.4"
	},
	"require-dev": {
		"psbitstest/example": "@dev",
		"roave/security-advisories": "dev-latest",
		"typo3/testing-framework": "^8.2"
	},
	"type": "typo3-cms-extension"
}
