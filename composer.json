{
    "authors": [
        {
            "email": "dn@phantasie-schmiede.de",
            "name": "Daniel Ablass",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSBits\\Security\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PSBits\\Security\\Tests\\": "Tests/"
        }
    },
    "config": {
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    },
    "description": "security enhancements for TYPO3 extensions",
    "extra": {
        "typo3/cms": {
            "extension-key": "security",
            "web-dir": ".Build/public"
        }
    },
    "keywords": [
        "configuration",
        "development",
        "extension",
        "typo3"
    ],
    "license": "GPL-3.0-or-later",
    "name": "psbits/security",
    "repositories": [
        {
            "type": "path",
            "url": "./Tests/Functional/Fixtures/Extensions/*"
        }
    ],
    "require": {
        "php": "^8.3",
        "psbits/foundation": "^4.0",
        "typo3/cms-core": "^13.4 || ^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11",
        "psbitstest/example": "@dev",
        "roave/security-advisories": "dev-latest",
        "saschaegerer/phpstan-typo3": "^2.1",
        "typo3/testing-framework": "^9.5"
    },
    "type": "typo3-cms-extension",
    "scripts": {
        "analyze:php": "phpstan analyse --configuration=Build/Quality/phpstan.neon.dist --no-progress",
        "audit:composer": "composer audit --abandoned=report",
        "docker:images": [
            "Composer\\Config::disableProcessTimeout",
            "sh Build/Scripts/buildTestImages.sh"
        ],
        "fix:all": [
            "@fix:php"
        ],
        "fix:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --verbose",
        "lint:all": [
            "@analyze:php",
            "@audit:composer",
            "@lint:php",
            "@lint:yaml",
            "@validate:composer"
        ],
        "lint:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --dry-run --diff --verbose",
        "lint:yaml": "yamllint -c Build/Quality/.yamllint.yml Configuration",
        "post-install-cmd": [
            "cp Build/GitHooks/pre-commit .git/hooks/pre-commit"
        ],
        "qa": [
            "@fix:all",
            "@lint:all",
            "@test:all"
        ],
        "test:all": [
            "@test:unit",
            "@test:functional",
            "@test:local",
            "@test:docker"
        ],
        "test:coverage": "sh Build/Scripts/runCoverage.sh @additional_args",
        "test:coverage:update-baseline": "sh Build/Scripts/runCoverage.sh --update-baseline @additional_args",
        "test:docker": [
            "Composer\\Config::disableProcessTimeout",
            "sh Build/Scripts/runDockerTests.sh @additional_args"
        ],
        "test:functional": "php -d memory_limit=1G .Build/bin/phpunit -c Build/Testing/FunctionalTests.xml",
        "test:local": [
            "Composer\\Config::disableProcessTimeout",
            "sh Build/Scripts/runLocalTests.sh @additional_args"
        ],
        "test:unit": "php -d memory_limit=1G .Build/bin/phpunit -c Build/Testing/UnitTests.xml",
        "validate:composer": "composer validate --no-check-publish"
    }
}
