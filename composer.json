{
	"authors": [
		{
			"email": "dn@phantasie-schmiede.de",
			"name": "Daniel Ablass",
			"role": "Developer"
		}
	],
	"autoload": {
		"psr-4": {
			"PSBits\\Security\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PSBits\\Security\\Tests\\": "Tests/"
		}
	},
	"config": {
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"description": "security enhancements for TYPO3 extensions",
	"extra": {
		"typo3/cms": {
			"app-dir": ".Build",
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "security",
			"web-dir": ".Build/public"
		}
	},
	"keywords": [
		"configuration",
		"development",
		"extension",
		"typo3"
	],
	"license": "GPL-3.0-or-later",
	"name": "psbits/security",
	"require": {
		"php": "^8.3",
		"psb/psb-foundation": "^2.0"
	},
	"require-dev": {
		"roave/security-advisories": "dev-latest",
		"typo3/testing-framework": "^8.2"
	},
	"type": "typo3-cms-extension"
}
